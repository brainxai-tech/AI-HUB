{
  "name": "ai-parallel-universe-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dist-server/server/index.js --prod",
    "build": "npm run artifact:check",
    "start": "node dist-server/server/index.js --prod",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.verify.json --noEmit",
    "artifact:check": "node -e \"const fs=require('node:fs');for(const f of ['dist/index.html','dist/assets/index-DIboQxEO.js','dist-server/server/hubModels.js','dist-server/server/index.js','dist-server/src/shared/contracts.js'])if(!fs.existsSync(f))throw new Error('Missing artifact: '+f)\"",
    "verify": "npm run typecheck && npm run test && npm run artifact:check"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
