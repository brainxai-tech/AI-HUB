{
  "name": "mbti-persona-compass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "clean": "node -e \"const fs=require('node:fs'); for (const d of ['dist','dist-server']) fs.rmSync(d,{recursive:true,force:true});\"",
    "build": "npm run clean && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js --prod",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
